# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est JAMAIS versionne (voir .gitignore).

# development | staging | production
# Hors development, l'API refuse de demarrer si une valeur ci-dessous est restee par defaut.
ENVIRONMENT=development

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=barryson
# Proprietaire du schema : utilise uniquement par les migrations.
POSTGRES_USER=barryson
POSTGRES_PASSWORD=changeme
# Compte de l'API : sans droit sur le schema ni sur les lignes du journal d'audit.
# Mot de passe distinct de celui du proprietaire (verifie au demarrage hors development).
POSTGRES_APP_USER=barryson_app
POSTGRES_APP_PASSWORD=changeme_app

# Cle maitresse (32 caracteres minimum hors development). En derivent : jetons CSRF,
# signature des scelles d'audit, chiffrement des secrets de double authentification.
# La changer invalide les scelles existants et oblige DG/admin a reconfigurer leur telephone.
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Noms de domaine acceptes dans l'en-tete Host, au format JSON.
# HOTES_AUTORISES='["erp.barryson.com"]'

# Derriere Caddy : adresse du proxy dont uvicorn accepte X-Forwarded-For
# (sinon toutes les tentatives de connexion semblent venir du proxy).
# FORWARDED_ALLOW_IPS=172.18.0.10

# Optionnel, developpement uniquement : ROLES_DOUBLE_FACTEUR=[] desactive le second facteur.
# Au demarrage, toute autre valeur que dg+administrateur est refusee hors developpement.
